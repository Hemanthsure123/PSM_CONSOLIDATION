# ─── Google Drive + Sheets ────────────────────────────────────────────────
# Destination folder for generated AI screening PDFs. The service account must
# have write access to this folder (share the folder with the service account
# email, or use a Shared Drive the service account is a member of).
#
# The internal Google Sheet you paste into the app, AND each candidate's resume
# file linked from it, must also be shared with the service-account email
# (Viewer is enough). Enable the Google Sheets API + Drive API on the project.
GOOGLE_DRIVE_FOLDER_ID=
# Optional: a Workspace user to impersonate via domain-wide delegation so PDF
# uploads to a My Drive folder work WITHOUT a Shared Drive. Requires enabling
# delegation on the service account and authorizing its client id (with the
# Drive scope) in the Google Workspace Admin console. Leave blank to instead use
# a Shared Drive folder (simpler, no admin console needed).
GOOGLE_DRIVE_IMPERSONATE_USER=

# ─── LLM (Google Gemini — primary, reads the resume PDF natively) ─────────
# Replace with your real Gemini API key (from Google AI Studio).
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
# Optional POOL of keys for the DSA-consolidation resume link-extraction step.
# Comma-separated; rotated round-robin with quota-cooldown. Falls back to
# GEMINI_API_KEY when empty.
GEMINI_API_KEYS=

# ─── Fallback LLM providers (used only when Gemini is exhausted) ───────────
# Order tried: Gemini (native PDF) → Groq → Mistral. Leave a key blank to skip
# that provider. Fallbacks read the resume as extracted text, not the PDF.
# Groq keys: https://console.groq.com/keys  ·  Mistral: https://console.mistral.ai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
# Optional round-robin POOLS (comma-separated). Every call starts on the next
# key; a key that hits a rate limit or quota is parked and the next one is used.
# When set, these replace the single *_API_KEY above.
MISTRAL_API_KEYS=
GROQ_API_KEYS=

# ─── Assignment Evaluation — model chain (optional) ────────────────────────
# Gemini models are tried top to bottom, each rotating across all Gemini keys.
# Mistral is used ONLY when Gemini is rate-limited / out of quota (never as a
# general fallback). Default (leave blank):
#   gemini:gemini-2.5-pro,gemini:gemini-3.1-pro-preview,gemini:gemini-3.8-flash,
#   gemini:gemini-3.5-flash,gemini:gemini-2.5-flash,mistral:codestral-latest,
#   mistral:ministral-14b-latest,mistral:ministral-8b-latest
# (Mistral free tier: codestral, ministral-3b/8b/14b work; mistral-small and
#  mistral-medium allow 0 requests/minute and are skipped.)
# Note: gemini-2.5-pro is not served to newly created Gemini keys, and the 3.x
# Pro models need a billing-enabled key — those tiers are skipped automatically.
ASSIGNMENT_LLM_CHAIN=

# ─── DSA consolidation — resume profile-link fallback chain (optional) ──────
# Used only when a resume has no clickable LeetCode/Codeforces/CodeChef link.
# 20 s per model; a rate-limited / slow Gemini model is skipped at once and the
# lookup moves to Mistral (round-robin across MISTRAL_API_KEYS). Default:
#   gemini:gemini-3.8-flash,gemini:gemini-3.1-flash-lite,gemini:gemini-2.5-flash,
#   mistral:ministral-8b-latest,mistral:ministral-3b-latest
LINKS_LLM_CHAIN=

# ─── Experience Analysis — model chain (optional) ──────────────────────────
# Gemini reads the resume PDF natively; on a Gemini rate limit the chain moves
# to Mistral free-tier models (on the extracted text). Default:
#   gemini:gemini-3.8-flash,gemini:gemini-3.5-flash,gemini:gemini-2.5-flash,
#   gemini:gemini-3.1-flash-lite,mistral:ministral-14b-latest,
#   mistral:ministral-8b-latest,mistral:codestral-latest
EXPERIENCE_LLM_CHAIN=

# QA Resume Screening (QA_LLM_CHAIN): same format. Empty = built-in default:
#   gemini:gemini-3.8-flash,gemini:gemini-3.5-flash,gemini:gemini-3-flash-preview,
#   gemini:gemini-3.1-flash-lite,gemini:gemini-2.5-flash,mistral:ministral-14b-latest,
#   mistral:codestral-latest,mistral:ministral-8b-latest
# Mistral is used only when Gemini is rate-limited — add MISTRAL_API_KEYS for big batches.
QA_LLM_CHAIN=

# Benchmark Projects (BENCHMARK_LLM_CHAIN): same format and same built-in default
# as QA_LLM_CHAIN. Empty = default.
BENCHMARK_LLM_CHAIN=

# ─── GitHub (for JD-matching project stats in the report) ─────────────────
# Personal Access Token (fine-grained or classic; public repo read is enough).
GITHUB_TOKEN=github_pat_REPLACE_WITH_YOUR_TOKEN
